# === CloudTrade Platform ===

# Google Gemini (backend only — never expose in frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database (Railway PostgreSQL auto-injects DATABASE_URL)
# Local dev fallback:
DATABASE_URL=sqlite:///./cloudtrade.db

# API
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
RATE_LIMIT_PER_MINUTE=60
WORKER_POLL_SECONDS=2.0

# Frontend (local Next.js — points to Railway API in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dhan (optional — real broker later)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Legacy GitHub push (optional)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
