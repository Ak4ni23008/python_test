{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r backend/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd backend && python -m app.workers.live_worker",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE"
  }
}
